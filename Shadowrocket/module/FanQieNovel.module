# ---------- ⑥ 红果短剧实测补漏（2026-10-14 17:02）----------
# 来源：红果短剧 3 小时抓包（ARP MITM 双向劫持）+ 逐条比对规则库
# ⚠️ 勘误（2026-10-14 17:20 复核）：② 段的 -hl 并非「误写」——公网实测
#    log5-applog-hl.fqnovel.com 真能解析（且非泛解析，假域 zzz-fake123 查不到），
#    是**有效规则，保留不删**。真实情况：抓包里 App 请求的是 -lf 系，
#    而规则里只有 -hl → 属「漏拦」，这里补齐 -lf 系。
# ⚠️ 关键：dnsmasq 的 address=/x/ 只在「标签边界」匹配，
#    写 applog-lf.fqnovel.com 拦不住 log5-applog-lf.fqnovel.com（前面是 - 不是 .）→ 必须列全域名
log5-applog-lf.fqnovel.com = 127.0.0.1 # # 番茄埋点 实测 136 次，最活跃
log3-applog-lf.fqnovel.com = 127.0.0.1 # # 番茄埋点 实测 27 次
rtlog5-applog-lf.fqnovel.com = 127.0.0.1 # # 番茄埋点 实测 27 次
rtlog3-applog-lf.fqnovel.com = 127.0.0.1 # # 番茄埋点 实测 4 次
mon11-misc-lf.fqnovel.com = 127.0.0.1 # # 番茄杂项上报 实测 26 次
mon3-misc-lf.fqnovel.com = 127.0.0.1 # # 番茄杂项上报 实测 2 次
