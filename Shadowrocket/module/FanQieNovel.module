# ── URL 正则 ──
# 原写法 `*-default.ixigua.com` 以量词 `*` 开头，不是合法正则，各内核都会在编译阶段丢弃该行（实际未生效）。
# 补成合法写法会同时命中西瓜/番茄的正常短剧流，故保持注释；如需启用请只针对具体节点单独添加。
# URL-REGEX,^https?:\/\/[a-z0-9-]+-default\.ixigua\.com,REJECT
URL-REGEX,^https?:\/\/[^\/]+\.byteimg\.com\/ad-app-package,REJECT
URL-REGEX,^https?:\/\/[^\/]+\.byteimg\.com\/web\.business\.image,REJECT

[URL Rewrite]
# 共用素材 CDN 上的广告素材：byteimg / douyinpic / ecombdimg / pstatp / pglstatp 一律按路径拒绝，
# 同节点的正常封面、头像、商品图不受影响（需 [MITM] 覆盖对应域名才能命中 HTTPS）。
^https?:\/\/[^\/]+\.(byteimg|douyinpic|ecombdimg|pstatp|pglstatp-toutiao)\.com\/(obj|img)\/(ad|ad-app-package|ad-pattern|web\.business\.image)\/.* _ reject
^https?:\/\/[^\/]+\.(byteimg|douyinpic|ecombdimg|pstatp|pglstatp-toutiao)\.com\/.*[?&](from|source)\=ad(&|$) _ reject

# 穿山甲 SDK 广告接口
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\/ _ reject
^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4 _ reject

# 头条 / 抖音
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package _ reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad _ reject
# 以下三条均为「死规则」：snssdk / pstatp 的路径型规则必须先被 [MITM] hostname 覆盖才能命中，
# 否则内核看不到 HTTPS 的路径，永不生效也不报错。其中 pstatp 那条已被上面第 108 行按通用形式包含。
# 故意不为 snssdk 扩大 MITM：域名级 REJECT（见 [Rule] 的 snssdk 精确域名）在 SNI 层即可拦截，不依赖 MITM；
# 把 +.snssdk.com 做全局 MITM 会把抖音大量接口卷入解密，触发证书校验（pinning）报错并拖慢 feed。
# 真要启用，请先在 [MITM] hostname 精确加入对应子域，再逐条核对日志命中。
# ^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+ _ reject
# ^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 _ reject
# ^https?:\/\/.+\.snssdk\.com\/api\/ad\/.+ _ reject

# 图片
# 路径格式较旧（-jpeg.jpeg 后缀）；字节当前封面多形如 tos-cn-i-1yzifmftcy/<hash>~noop.jpeg，可能已对不上。
# 需要用圈X/小火箭抓一条真实封面或广告 URL 后再改写，不要凭猜测扩写成更宽的正则。
^https?:\/\/.+\.byteimg\.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg _ reject

[MITM]
# byteimg / douyinpic / ecombdimg 必须进入 MITM，上方按广告路径的 [URL Rewrite] 才能命中 HTTPS；
# 这三族是图片视频 CDN，若某节点做了证书校验（pinning）导致封面异常，从本行删掉对应域名即可，规则本身不受影响。
hostname = %APPEND% *.pangolin-sdk-toutiao.*,*.pstatp.com,*.pglstatp-toutiao.com,*.byteimg.com,*.douyinpic.com,*.ecombdimg.com,gurd.snssdk.com,gurd.snssdk.com.*,*default.ixigua.com
