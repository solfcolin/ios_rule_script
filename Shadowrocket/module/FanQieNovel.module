# ============================================================
# 手工精挑补充规则（2026-10-05 添加）
# 来源：本机 dnsmasq 实测日志分析（queries.log 238,094 行 / 1,991 个唯一域名）
# 加规则原则：只取「上报 / 统计 / 追踪」类
#            绝不碰「播放 / 支付 / 定位 / 系统服务 / 云基础设施」
# ============================================================

# ---------- ① DoH 加固：强制 App 回落到本机 DNS ----------
# 日志实测 19:14:02 出现（来源手机 100.64.0.2）
# App 走加密 DNS 时解析完全不经过本机 → 拦不住也看不见
# 拦掉后 App 会回落到系统 DNS（= 本机 dnsmasq），拦截覆盖面变大
dns.alidns.com = 127.0.0.1
_dns.resolver.arpa = 127.0.0.1

# ---------- ② 番茄小说 埋点上报（纯统计，无副作用）----------
# 实测 257 / 151 / 35 / 35 次，最后 19:13 仍活跃
log5-applog-hl.fqnovel.com = 127.0.0.1
rtlog5-applog-hl.fqnovel.com = 127.0.0.1
rtlog3-applog-hl.fqnovel.com = 127.0.0.1
mon11-misc-hl.fqnovel.com = 127.0.0.1

# ---------- ③ 小红书 埋点 + 广告素材 ----------
# lng / spider-tracker 实测 98 / 61 次，最后 19:14 仍活跃
lng.xiaohongshu.com = 127.0.0.1
spider-tracker.xiaohongshu.com = 127.0.0.1
apm-native.xiaohongshu.com = 127.0.0.1
ads-vp5.xhscdn.com = 127.0.0.1

