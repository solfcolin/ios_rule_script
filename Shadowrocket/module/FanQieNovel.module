#!name=番茄小说 @zqzess
#!desc=番茄小说广告屏蔽, version = 3.17

[Rule]
# ── 关键词 ──
# DOMAIN-KEYWORD,zijieapi,REJECT

# ── 域名后缀：广告投放与统计上报 ──
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,p3-ad-sign.byteimg.com,REJECT-200
DOMAIN-SUFFIX,p26-orange-sign.byteimg.com,REJECT-DICT

# ── 域名后缀：广告素材 / 图片 CDN ──
DOMAIN-SUFFIX,p3.douyinpic.com,REJECT-DICT
DOMAIN-SUFFIX,p3-sign.douyinpic.com,REJECT-DICT
DOMAIN-SUFFIX,p3-webcast-sign.douyinpic.com,REJECT-DICT
DOMAIN-SUFFIX,p11.douyinpic.com,REJECT
DOMAIN-SUFFIX,p11-webcast-sign.douyinpic.com,REJECT-DICT
DOMAIN-SUFFIX,p26.douyinpic.com,REJECT
DOMAIN-SUFFIX,p3-novel.byteimg.com,REJECT
DOMAIN-SUFFIX,p6-novel.byteimg.com,REJECT
DOMAIN-SUFFIX,p6-novel-sign.byteimg.com,REJECT
DOMAIN-SUFFIX,p9-novel-sign.byteimg.com,REJECT
DOMAIN-SUFFIX,p9-reading-sign.fqnovelpic.com,REJECT
DOMAIN-SUFFIX,p3-aio.ecombdimg.com,REJECT
DOMAIN-SUFFIX,p9-aio.ecombdimg.com,REJECT
DOMAIN-SUFFIX,p3-ecom-qualification-sign.ecombdimg.com,REJECT-DICT
DOMAIN-SUFFIX,p26-item.ecombdimg.com,REJECT
DOMAIN,lf-normal-gr-sourcecdn.bytegecko.com,REJECT
DOMAIN,lf-normal-login-sourcecdn.bytegecko.com,REJECT

# ── 域名后缀：小说 / 视频 App 侧接口 ──
DOMAIN-SUFFIX,v5-novelapp.fqnovelvod.com,REJECT
DOMAIN-SUFFIX,v11-novelapp.fqnovelvod.com,REJECT
DOMAIN-SUFFIX,v26-novelapp.fqnovelvod.com,REJECT
DOMAIN-SUFFIX,v95-zjjx2tc-novelapp.fqnovelvod.com,REJECT
DOMAIN-SUFFIX,v95-se-zjwztc-novelapp.fqnovelvod.com,REJECT
DOMAIN-SUFFIX,v5-bd-daily-reading-ad.qznovelvod.com,REJECT
DOMAIN-SUFFIX,v9-reading-ad.qznovelvod.com,REJECT
DOMAIN-SUFFIX,mon11-misc-hl.fqnovel.com,REJECT
DOMAIN-SUFFIX,xpis-tel-xcdn.youku.com,REJECT-DICT
DOMAIN-SUFFIX,vc-brain-v6.ndcpp.com,REJECT

# ── 域名后缀：字节广告跳转域名 ──
DOMAIN-SUFFIX,byteorge.com,REJECT
DOMAIN-SUFFIX,bytegoofy.com,REJECT

# ── 精确域名：穿山甲 / 巨量引擎 ──
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT
DOMAIN,dig.bdurl.net,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT

# ── 精确域名：头条 / 抖音 SDK ──
DOMAIN,i.snssdk.com,REJECT
DOMAIN,i-lq.snssdk.com,REJECT
DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,is.snssdk.com,REJECT
DOMAIN,security-lq.snssdk.com,REJECT
DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT

# ── 精确域名：西瓜视频 ──
DOMAIN,default.ixigua.com,REJECT
DOMAIN,v6-novelapp.ixigua.com,REJECT

# ── 精确域名：第三方 ──
DOMAIN,msync-im1-vip6-std.easemob.com,REJECT
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,REJECT
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,fmy420-01-gyf.bj.bilivideo.com,REJECT

# ── IP ──
IP-CIDR,49.71.37.101/32,REJECT,no-resolve
IP-CIDR,101.36.166.16/32,REJECT,no-resolve
IP-CIDR,117.71.105.23/32,REJECT,no-resolve
IP-CIDR,117.92.229.188/32,REJECT,no-resolve
IP-CIDR,180.96.2.114/32,REJECT,no-resolve
IP-CIDR,218.94.207.205/32,REJECT,no-resolve

# ── URL 正则 ──
URL-REGEX,*-default.ixigua.com,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/ad-app-package,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/web\.business\.image,REJECT

[URL Rewrite]
# 穿山甲 SDK 广告接口
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\/ _ reject
^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4 _ reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/(ad-app-package|ad)\/.+ _ reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/.+ _ reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer _ reject

# 头条 / 抖音
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package _ reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad _ reject
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+ _ reject
^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 _ reject
^https?:\/\/.+\.snssdk\.com\/api\/ad\/.+ _ reject

# 图片
^https?:\/\/.+\.byteimg\.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg _ reject

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.*,*.pstatp.com,*.pglstatp-toutiao.com,gurd.snssdk.com,gurd.snssdk.com.*,*default.ixigua.com
